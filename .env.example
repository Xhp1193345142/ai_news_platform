# Application
APP_ENV=development
APP_NAME=AI Signal API
API_V1_PREFIX=/api/v1
DEBUG=true
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080
VITE_API_BASE_URL=/api/v1
PYTHON_IMAGE=python:3.12-slim

# PostgreSQL
POSTGRES_DB=ai_signal
POSTGRES_USER=ai_signal
POSTGRES_PASSWORD=change-me-in-local-env
DATABASE_URL=postgresql+asyncpg://ai_signal:change-me-in-local-env@postgres:5432/ai_signal
SYNC_DATABASE_URL=postgresql+psycopg://ai_signal:change-me-in-local-env@postgres:5432/ai_signal

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=ai_signal_admin
MINIO_ROOT_PASSWORD=change-me-minio-secret
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=ai_signal_admin
S3_SECRET_KEY=change-me-minio-secret
S3_PUBLIC_BUCKET=ai-signal-public
S3_ARCHIVE_BUCKET=ai-signal-archive
S3_REGION=us-east-1

# Authentication (replace before any shared or production environment)
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-use
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
